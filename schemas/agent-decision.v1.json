{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embodied-worlds.local/schemas/agent-decision.v1.json",
  "title": "AgentDecision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": { "$ref": "action-request.v1.json" },
    "decision_summary": { "type": "string", "maxLength": 500, "default": "" },
    "agent_metadata": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "value_estimate": { "type": "number" },
            "policy_entropy": { "type": "number", "minimum": 0 },
            "planner": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "expanded_nodes": { "type": "integer", "minimum": 0 },
                "planning_time_ms": { "type": "number", "minimum": 0 }
              },
              "required": ["name"]
            }
          }
        },
        { "type": "null" }
      ],
      "default": null
    }
  },
  "required": ["action"]
}
